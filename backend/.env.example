# Copy this file to .env and fill in real values.
# .env is gitignored; this template is committed so other developers know
# which variables the project needs.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=ticket
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Email. The console backend prints messages to the terminal instead of
# sending them. Switch to smtp.EmailBackend and fill the rest to send for real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=helpdesk@example.com

# Used to build ticket links inside notification emails.
FRONTEND_URL=http://127.0.0.1:5500
